# Copy these values into AWS App Runner's runtime environment configuration.
# Store all credentials in AWS Secrets Manager; do not commit a real .env file.
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/expense-tracker?retryWrites=true&w=majority
JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRES_IN=7d

FRONTEND_URL=https://your-frontend-domain.example
ORIGIN=https://your-frontend-domain.example
RP_ID=your-frontend-domain.example

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://YOUR_APP_RUNNER_DOMAIN/auth/google/callback

GOOGLE_SHEET_CSV_URL=
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_DAY=10000
AUDIT_LOG_RETENTION_DAYS=90

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Set true on exactly one backend instance to run scheduled notifications.
RUN_CRON=false
    